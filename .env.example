# Labeled synthetic demos and saved results work without API keys.
OPENAI_API_KEY=
TYPESAFE_API_KEY=
OPENAI_MODEL=gpt-6-luna
TYPESAFE_MODEL=jev-latest
# Verification is intentionally fixed to gpt-6.1-sol.

# Connectivity uses authored-text embeddings; no TypeSafe key is required.
AGENT_EMBEDDING_MODEL=text-embedding-3-small
