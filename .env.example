# Labeled synthetic demos and saved results work without API keys.
OPENAI_API_KEY=
TYPESAFE_API_KEY=
OPENAI_MODEL=gpt-6-luna
TYPESAFE_MODEL=jev-latest
# Verification is intentionally fixed to gpt-6.1-sol.

# Optional image endpoint. It uses OPENAI_API_KEY and is enabled explicitly.
IMAGE_ANALYSIS_ENABLED=false
IMAGE_ANALYSIS_MODEL=gpt-4.1-mini
